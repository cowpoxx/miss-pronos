generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?   @map("displayName")
  image         String?   @map("avatarUrl")
  passwordHash  String?   @map("password_hash")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts      Account[]
  sessions      Session[]
  groups        GroupMember[]
  predictions   Prediction[]
  scores        Score[]
  createdGroups Group[]   @relation("GroupCreator")
  enteredResults OfficialResult[] @relation("ResultEnterer")

  @@map("Profile")
}

model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text @map("refresh_token")
  access_token      String? @db.Text @map("access_token")
  expires_at        Int?    @map("expires_at")
  token_type        String? @map("token_type")
  scope             String?
  id_token          String? @db.Text @map("id_token")
  session_state     String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Edition {
  id              String   @id @default(uuid())
  year            Int      @unique
  title           String
  startDate       DateTime @map("start_date")
  resultsLockedAt DateTime? @map("results_locked_at")
  isActive        Boolean  @default(false) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")

  candidates      Candidate[]
  groups          Group[]
  predictions     Prediction[]
  officialResult  OfficialResult?
  scores          Score[]
  ballots         Ballot[]
}

model Candidate {
  id          String   @id @default(uuid())
  editionId   String   @map("edition_id")
  number      Int
  name        String
  region      String
  photoUrl    String?  @map("photo_url")
  sortOrder   Int      @default(0) @map("sort_order")

  edition     Edition  @relation(fields: [editionId], references: [id], onDelete: Cascade)
  predictions Prediction[] @relation("PredictionWinner")

  @@unique([editionId, number])
}

model Group {
  id              String   @id @default(uuid())
  name            String
  code            String   @unique @default(uuid())
  createdById     String   @map("created_by_id")
  editionId       String   @map("edition_id")
  scoringRules    Json     @map("scoring_rules")
  revealPredictions Boolean @default(false) @map("reveal_predictions")
  createdAt       DateTime @default(now()) @map("created_at")

  createdBy       User  @relation("GroupCreator", fields: [createdById], references: [id])
  edition         Edition  @relation(fields: [editionId], references: [id])
  members         GroupMember[]
  predictions     Prediction[]
  scores          Score[]
}

model GroupMember {
  groupId   String   @map("group_id")
  userId    String   @map("user_id")
  role      String   @default("player")
  joinedAt  DateTime @default(now()) @map("joined_at")

  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
}

model Prediction {
  id          String   @id @default(uuid())
  groupId     String   @map("group_id")
  userId      String   @map("user_id")
  editionId   String   @map("edition_id")
  winnerId    String?  @map("winner_id")
  top5        Json     @default("[]")
  favorites   Json     @default("[]")
  submittedAt DateTime @default(now()) @map("submitted_at")
  lockedAt    DateTime? @map("locked_at")

  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  edition     Edition  @relation(fields: [editionId], references: [id], onDelete: Cascade)
  winner      Candidate? @relation("PredictionWinner", fields: [winnerId], references: [id])

  @@unique([groupId, userId, editionId])
}

model Ballot {
  id             String   @id @default(uuid())
  editionId      String   @map("edition_id")
  name           String
  normalizedName String   @map("normalized_name")
  top5           Json     @default("[]")
  points         Int?
  breakdown      Json?
  submittedAt    DateTime @default(now()) @map("submitted_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  edition Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([editionId, normalizedName])
  @@index([editionId, submittedAt])
}

model OfficialResult {
  editionId   String   @id @map("edition_id")
  winnerId    String?  @map("winner_id")
  top5        Json     @default("[]")
  enteredById String?  @map("entered_by_id")
  enteredAt   DateTime @default(now()) @map("entered_at")

  edition     Edition  @relation(fields: [editionId], references: [id], onDelete: Cascade)
  enteredBy   User? @relation("ResultEnterer", fields: [enteredById], references: [id])
}

model Score {
  id            String   @id @default(uuid())
  groupId       String   @map("group_id")
  userId        String   @map("user_id")
  editionId     String   @map("edition_id")
  totalPoints   Int      @default(0) @map("total_points")
  breakdown     Json     @default("{}")
  calculatedAt  DateTime @default(now()) @map("calculated_at")

  group         Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user          User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  edition       Edition  @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId, editionId])
}